 # Axrachat - Environment Variables
PORT=3000
NODE_ENV=development

# MongoDB - Use local or Atlas
MONGO_URI=mongodb://localhost:27017/axrachat
# For production: mongodb+srv://username:password@cluster.mongodb.net/axrachat

# JWT Secret - CHANGE THIS!
JWT_SECRET=axrachat_super_secret_key_2026_change_this_to_random_32_chars

# Cloudinary (Optional for production image hosting)
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret

CLIENT_URL=http://localhost:3000
